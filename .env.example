# Template — copy to .env and fill in your values

PORT=3000

# true = serve https://localhost:PORT with your own certificate (SSL_KEY / SSL_CERT)
USE_HTTPS=false
SSL_KEY=ss.key
SSL_CERT=ss.crt

# Google Gemini API key (https://aistudio.google.com/apikey)
GEM_KEY=your_google_gemini_api_key
GEM_MODEL=gemini-2.5-flash
